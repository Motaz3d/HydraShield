{
  "$schema_note": "Lead record schema v2 for marketing/leads/*.json — one file per organization. BINDING: a lead exists only from a real, checkable source (official site, registry, public professional profile). No invented organizations, no invented people, no invented interactions. Every record carries source + date_checked. Personal contact data only from a legitimate public/business source where legally appropriate.",
  "schema": {
    "organization": {"type": "string", "required": true},
    "segment": {"type": "enum", "values_from": "../segments/segments.json", "required": true},
    "country": {"type": "string", "required": true},
    "region": {"type": "string", "required": false},
    "website": {"type": "url", "required": true},
    "decision_maker_role": {"type": "enum", "values_from": "segments.decision_maker_roles_vocabulary", "note": "a ROLE, never an invented name; a named person only from a public professional source"},
    "contact_type": {"type": "enum", "values": ["organization_generic", "role_based_public", "named_public_professional"], "required": true},
    "identified_problem": {"type": "string", "note": "the climate problem this organization plausibly has, from public evidence"},
    "climate_exposure": {"type": "string"},
    "potential_pain": {"type": "string"},
    "relevant_hazards": {"type": "list", "values": ["wildfire", "flood", "drought", "heat", "wind", "coastal"]},
    "commercial_signals": {"type": "list", "items": "signal ids from marketing/signals/", "default": []},
    "event_signals": {"type": "list", "items": "event ids/files from marketing/events/", "default": []},
    "evidence": {"type": "string", "note": "what evidence to show them"},
    "relevant_capability": {"type": "string", "note": "must name a real platform capability"},
    "recommended_product": {"type": "enum", "values": ["free_analysis", "professional_report", "monitoring", "alerts_sms", "api", "enterprise_dashboard", "organization_account", "custom_analysis", "climate_risk_intelligence", "historical_event_intelligence", "solutions_intelligence"]},
    "recommended_message": {"type": "string", "note": "the angle, not a full draft"},
    "priority": {"type": "enum", "values": ["low", "medium", "high"]},
    "fit_score": {"type": "string", "note": "qualitative fit reasoning, not a fabricated metric"},
    "urgency": {"type": "enum", "values": ["low", "medium", "high"], "note": "tied to a real signal/date, else low"},
    "outreach_status": {"type": "enum", "values": ["researched", "qualified", "draft_prepared", "contacted", "responded", "opportunity", "closed_lost"], "default": "researched"},
    "status": {"type": "enum", "values": ["open", "nurturing", "won", "lost", "dormant"], "default": "open"},
    "interactions": {"type": "list", "items": {"date": "date", "type": "discovered|researched|contacted|replied|meeting|demo|report_requested|trial|subscription|lost|follow_up", "summary": "string", "source": "string (where applicable)", "next_action": "string"}, "note": "real interactions only — the relationship history"},
    "last_contact": {"type": "date", "required": false},
    "next_action": {"type": "string"},
    "next_followup": {"type": "date", "required": false},
    "owner": {"type": "string", "default": "operator"},
    "source": {"type": "url", "required": true},
    "date_checked": {"type": "date", "required": true}
  }
}
