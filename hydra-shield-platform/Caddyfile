# Caddy configuration for Talaix.
# Caddy provisions and renews TLS certificates automatically (Let's Encrypt).

# Apex domain: static marketing site + REST API under /api/*
talaix.com {
	encode zstd gzip

	# REST API (Flask)
	handle /api/* {
		reverse_proxy api:8051
	}

	# Operator shells: served by the API only after server-side
	# authorization (never public static files). /marketing.html is a
	# legacy alias that redirects into the /admin.html tabs.
	handle /admin.html {
		reverse_proxy api:8051
	}
	handle /marketing.html {
		reverse_proxy api:8051
	}

	# Everything else: static website files
	handle {
		root * /srv/website
		# Clean URL for the human-facing source registry (the API stays
		# JSON at /api/sources).
		rewrite /sources /sources.html
		rewrite /sources/ /sources.html
		file_server
	}

	# Consolidated audience portals: the seven for-* landing pages merged
	# into the single industries hub (+ press). Old links, emails and
	# bookmarks keep working via permanent redirects.
	redir /for-banks.html /industries.html?sector=banks permanent
	redir /for-insurance.html /industries.html?sector=insurance permanent
	redir /for-investors.html /industries.html?sector=investors permanent
	redir /for-real-estate.html /industries.html?sector=real-estate permanent
	redir /for-consulting.html /industries.html?sector=consulting permanent
	redir /for-government.html /industries.html?sector=government permanent
	redir /for-journalists.html /press.html permanent
}

# Live interactive Dash dashboard
app.talaix.com {
	encode zstd gzip
	reverse_proxy dash:8050
}

# www alias: one canonical home (SEO) — redirect to the apex.
www.talaix.com {
	encode zstd gzip
	redir https://talaix.com{uri} permanent
}

# Legacy domain (rebrand 2026-08): permanently redirect every URL to the
# new home so old links, emails and bookmarks keep working.
hydrashield.earth, www.hydrashield.earth {
	encode zstd gzip
	redir https://talaix.com{uri} permanent
}

app.hydrashield.earth {
	encode zstd gzip
	redir https://app.talaix.com{uri} permanent
}
