# Talaix environment configuration (copy to .env next to docker-compose.yml)
# All values are optional; the platform runs without them and reports the
# corresponding layers as unavailable.

# NASA FIRMS active-fire API key (free registration):
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Hunter.io API key for contact discovery, email finder and email verification
# in the Marketing CRM (leave empty to disable Hunter features)
HUNTER_API_KEY=

# Kimi API key for optional AI prose polish in the Report Builder (leave empty
# to disable AI features and return 503 on polish requests)
KIMI_API_KEY=

# Kimi provider: "code" = Kimi Code membership API (api.kimi.com, default);
# "platform" = pay-as-you-go Kimi Platform (api.moonshot.cn);
# "platform-international" = pay-as-you-go international (api.moonshot.ai)
KIMI_PROVIDER=code

# Optional overrides (normally left empty — defaults come from the provider):
# KIMI_BASE_URL=            full chat-completions endpoint override
# KIMI_MODEL_CHEAP=         cheap tier model id (default per provider)
# KIMI_MODEL_STRONG=        strong tier model id (default per provider)

# Daily cap on server-side AI calls across all tasks (default: 50)
AI_DAILY_CALL_CAP=50

# Daily outreach send cap (immediate + scheduled sends). Default: 20.
DAILY_SEND_CAP=20

# Automatic follow-up: when a contact import adds genuinely new contacts to
# a lead, queue one scheduled outreach email per contact (sending still goes
# through the cron processor — daily cap and unsubscribe rules apply).
# Off unless set to 1.
AUTO_OUTREACH_ON_CONTACT=

# SMTP for watch alert + transactional emails (leave empty to use the dev
# backend: emails are written as .eml files to data/outbox/, never sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASSWORD is the canonical variable; the legacy SMTP_PASS below is
# still accepted by the mailer when SMTP_PASSWORD is unset.
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=info@talaix.com

# Inbox that receives contact-form submissions and operator notifications
# (defaults to SMTP_FROM)
CONTACT_INBOX=info@talaix.com

# IMAP reply inbox (Phase 18). Used by scripts/check_replies.py to detect
# replies/unsubscribes and auto-stop outreach. Leave unset to disable reply
# checks; IMAP_PASSWORD is accepted as a legacy alias for IMAP_PASS.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# SMS alerting (leave SMS_PROVIDER empty to use the dev backend: messages
# are written as .sms.txt files to data/outbox/, never sent).
# SMS_PROVIDER=http selects the generic HTTPS provider — then SMS_HTTP_URL
# is REQUIRED (POST JSON {"to","from","message"}). Credentials come from the
# environment only and are never stored or logged; no values are set here.
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_FROM=
SMS_API_KEY=
SMS_API_SECRET=
# Auth header template; {key}/{secret} are substituted from the vars above
#SMS_HTTP_AUTH_HEADER=Authorization: Bearer {key}

# SMS_PROVIDER=twilio selects Twilio — all three variables are REQUIRED
# (form-encoded POST to the account's Messages endpoint, Basic auth with
# SID:token; sender is the Twilio-owned number):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional per-template sender aliases (Google Workspace "Send mail as"
# aliases of the info@ account — must be configured in Gmail settings by
# the operator; the platform never invents sender identities). Pattern:
# SMTP_FROM_<TEMPLATE>. Examples:
#SMTP_FROM_ALERT=alerts@talaix.com
#SMTP_FROM_REPORT_READY=reports@talaix.com
#SMTP_FROM_REPORT_DELIVERY=reports@talaix.com

# Server-side secret for hashing session/email tokens (HMAC-SHA256).
# When unset, a development fallback is derived from machine-stable
# attributes (hostname + user home) — set an explicit random value in
# production, e.g. `openssl rand -hex 32`.
HYDRASHIELD_SECRET_KEY=

# Operator accounts (server-side admin role). Comma-separated emails;
# a listed account is promoted to admin at session resolution — there is
# no endpoint or client path to set a role. Production:
# HYDRASHIELD_OPERATOR_EMAILS=info@talaix.com
HYDRASHIELD_OPERATOR_EMAILS=

# Cache / watch / accounts database location inside the containers
HYDRASHIELD_CACHE_DB=/data/hydrashield_cache.sqlite3

# CORS for the read-only public GET API (docs/API_FIRST_STRATEGY.md §3):
# comma-separated EXACT origins allowed to call the public GET endpoints
# (e.g. https://app.example.com,https://gis.example.org). Default: empty →
# no CORS headers (same-origin only). Never use "*" and never combine with
# credentials; auth/account endpoints never receive CORS headers.
HYDRASHIELD_CORS_ORIGINS=

# Local disk cache for the one-time WorldPop country population rasters
# (default: data/population/ inside the platform directory)
HYDRASHIELD_POPULATION_DIR=

# CAMS (Copernicus Atmosphere Monitoring Service) — CANDIDATE source, not
# wired into the pipeline. Would provide aerosol/PM context + validation of
# smoke-transport estimates. Requires free CDS credentials:
# https://ads.atmosphere.copernicus.eu/ (see config/source_registry.json)
CAMS_ADS_URL=
CAMS_ADS_KEY=
